# Copy to .env to override the development defaults in compose.yaml. Never commit real values.
POSTGRES_PASSWORD=
OCOP_MIGRATOR_PASSWORD=
OCOP_APP_PASSWORD=
OCOP_READONLY_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
APP_BASE_URL=http://localhost:8080
# ADR 0003: set to false only if the deploying unit opts out of mandatory TOTP.
TOTP_REQUIRED=true
# 32 random bytes, base64: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
MAIL_FROM=OCOP <no-reply@ocop.local>
