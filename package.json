{
  "name": "ocop",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm run lint:deps",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "int": "pnpm -s --filter @ocop/infra exec vitest run --config vitest.int.config.ts --reporter=dot",
    "e2e": "bash scripts/e2e.sh",
    "format": "prettier --write --log-level warn .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.0",
    "prettier": "3.9.10",
    "turbo": "^2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
